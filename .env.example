# Copy this file to .env and fill in your key. .env is git-ignored.
#
#   fal.ai API key — used by the art pipeline (packages/art) to generate card
#   artwork with Nano Banana Pro. Get one at https://fal.ai/dashboard/keys
FAL_KEY=

#   Supabase SERVICE ROLE key — used by apps/server to write trophies, chests
#   and card copies. SECRET: it bypasses row level security, so it belongs in
#   the host's environment (Railway → Variables), never in the repo.
#   Without it the server plays matches normally and saves nothing.
SUPABASE_SERVICE_KEY=
