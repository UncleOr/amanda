# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# env & secrets
.env
.env.*
!.env.example

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# native mobile build artifacts
#
# `android/` as a whole used to be ignored, which also made it impossible to
# re-include anything inside it: git does not descend into an excluded
# DIRECTORY, so a later `!android/twa-manifest.json` is never even considered.
# Excluding the contents instead leaves that door open.
android/*
ios/

# full-length source soundtracks (~17MB) — kept local; the trimmed, compressed
# clips used by the game live in apps/client/public/music and ARE committed.
soundtracks/

# raw AI art output (large PNGs) — kept local, back these up!
# the compressed webp the game actually ships live in apps/client/public/cards
assets/raw/

# the loose copy of the source deck at the repo root; the filed copy under
# assets/reference/ is the one that ships
/קלפי מפלצות עם בליד.pdf
.scratch/

# Skills Or downloaded to look at — not part of the game.
/SKILL.md
/SKILL (1).md

# The TWA wrapper's config IS committed — it is what makes a rebuild
# reproducible. Everything else bubblewrap generates stays out, and two of
# those files are secrets that must never reach a public repository:
# android.keystore is the upload key, and the file beside it is its password.
!android/twa-manifest.json

# Generated store assets. scripts/make-trailer.sh rebuilds the video from the
# screenshots and the score in under a minute, so a 7MB binary does not need
# to live in a public repository; store/raw/ is wherever you dropped the phone
# captures before scripts/screenshots.sh converted them.
store/trailer.mp4
store/raw/

# Screen recordings. Source footage is tens of megabytes and this repo is
# public; scripts/cut-gameplay.sh turns one into the few seconds that ship.
/*.mp4
/*.mov
store/gameplay.mp4
