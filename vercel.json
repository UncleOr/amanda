{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @amanda/client build",
  "outputDirectory": "apps/client/dist",
  "github": { "silent": true },
  "headers": [
    {
      "comment": "The service worker must never be served stale, or a new deploy can never reach anyone already running the app.",
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "comment": "Hashed build output is immutable.",
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
