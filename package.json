{
  "name": "amanda",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Amanda — online real-time multiplayer auto-battler card game",
  "scripts": {
    "validate:data": "pnpm --filter @amanda/shared validate:data",
    "typecheck": "pnpm -r typecheck",
    "art:style": "pnpm --filter @amanda/art style",
    "art:anchor": "pnpm --filter @amanda/art anchor",
    "art:cards": "pnpm --filter @amanda/art cards",
    "art:card": "pnpm --filter @amanda/art card",
    "art:process": "pnpm --filter @amanda/art process",
    "art:actions": "pnpm --filter @amanda/art actions",
    "art:arena": "pnpm --filter @amanda/art arena",
    "art:icons": "pnpm --filter @amanda/art icons",
    "copy": "node scripts/copy-inventory.mjs",
    "copy:apply": "node scripts/copy-apply.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
