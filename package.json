{
  "name": "amanda",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Amanda — online real-time multiplayer auto-battler card game",
  "scripts": {
    "validate:data": "pnpm --filter @amanda/shared validate:data",
    "typecheck": "pnpm -r typecheck",
    "art:style": "pnpm --filter @amanda/art style",
    "art:anchor": "pnpm --filter @amanda/art anchor",
    "art:cards": "pnpm --filter @amanda/art cards",
    "art:card": "pnpm --filter @amanda/art card",
    "art:process": "pnpm --filter @amanda/art process",
    "art:actions": "pnpm --filter @amanda/art actions",
    "art:arena": "pnpm --filter @amanda/art arena",
    "art:icons": "pnpm --filter @amanda/art icons",
    "copy": "node scripts/copy-inventory.mjs",
    "copy:back": "node scripts/copy-back.mjs",
    "copy:test": "node --test scripts/xlsx.test.mjs",
    "tutorial": "node scripts/tutorial-doc.mjs",
    "copy:apply": "node scripts/copy-apply.mjs",
    "art:brand": "pnpm --filter @amanda/art brand",
    "art:icons-set": "pnpm --filter @amanda/art icons-set",
    "art:achievements": "pnpm --filter @amanda/art achievements",
    "art:emoji": "pnpm --filter @amanda/art emoji",
    "art:animate": "pnpm --filter @amanda/art animate",
    "art:sounds": "pnpm --filter @amanda/art sounds",
    "art:fanfare": "pnpm --filter @amanda/art fanfare",
    "art:sounds-process": "pnpm --filter @amanda/art sounds-process",
    "art:surfaces": "pnpm --filter @amanda/art surfaces",
    "art:scenes": "pnpm --filter @amanda/art scenes",
    "art:trailer": "pnpm --filter @amanda/art trailer",
    "copy:codemod": "node scripts/copy-codemod.mjs",
    "copy:verify": "node scripts/copy-verify.mjs",
    "art:voices": "pnpm --filter @amanda/art voices",
    "art:voices-process": "pnpm --filter @amanda/art voices-process"
  },
  "engines": {
    "node": ">=20"
  }
}
