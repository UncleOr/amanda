{
  "name": "@amanda/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Amanda authoritative multiplayer server (WebSocket)",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@amanda/engine": "workspace:*",
    "@amanda/shared": "workspace:*",
    "@supabase/supabase-js": "^2.117.2",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
